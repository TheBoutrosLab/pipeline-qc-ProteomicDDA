includeConfig "${projectDir}/config/default.config"
includeConfig "${projectDir}/config/methods.config"
includeConfig "${projectDir}/nextflow.config"

def TEST_DATA_DIR = System.getenv('TEST_DATA_DIR')
def csvTools = evaluate(new File("${projectDir}/test/csv_environment_expander.groovy"))

params {
    dataset_id = 'DDA_QC_NFTEST'
    mzml_csv = "${projectDir}/test/test-integration-TMT-ProteinProphet/mzml.csv"
    search_idxml_csv = "${projectDir}/test/test-integration-TMT-ProteinProphet/search.csv"
    filtered_idxml_csv = "${projectDir}/test/test-integration-TMT-ProteinProphet/filtered.csv"
    inference_route = 'ProteinProphet'
    protein_groups = "${TEST_DATA_DIR}/ecoli_tmt/metapipeline-ProteomicDDA-ProteinProphet/metapipeline-ProteomicDDA-1.0.0/ecoli_tmt/main_workflow/quantitate-ProteomicProtein-1.1.1/ecoli_tmt/OpenMS-3.5.0/intermediate/filter_protein_groups/ecoli_tmt_ProteinProphet_filtered.idXML"
    protein_quant_csv = "${TEST_DATA_DIR}/ecoli_tmt/metapipeline-ProteomicDDA-ProteinProphet/metapipeline-ProteomicDDA-1.0.0/ecoli_tmt/main_workflow/quantitate-ProteomicProtein-1.1.1/ecoli_tmt/OpenMS-3.5.0/output/ecoli_tmt_ProteinQuantifier_protein.csv"
    peptide_quant_csv = "${TEST_DATA_DIR}/ecoli_tmt/metapipeline-ProteomicDDA-ProteinProphet/metapipeline-ProteomicDDA-1.0.0/ecoli_tmt/main_workflow/quantitate-ProteomicProtein-1.1.1/ecoli_tmt/OpenMS-3.5.0/output/ecoli_tmt_ProteinQuantifier_peptide.csv"
}
params.mzml_csv = csvTools.prepareInputCsv(params.mzml_csv, 'TMT-ProteinProphet-mzml', launchDir)
params.search_idxml_csv = csvTools.prepareInputCsv(params.search_idxml_csv, 'TMT-ProteinProphet-search', launchDir)
params.filtered_idxml_csv = csvTools.prepareInputCsv(params.filtered_idxml_csv, 'TMT-ProteinProphet-filtered', launchDir)
methods.setup()
process {
    echo = false
    debug = false
}
