includeConfig "${projectDir}/config/default.config"
includeConfig "${projectDir}/config/methods.config"
includeConfig "${projectDir}/nextflow.config"

params {
    dataset_id = 'cohort'
    mzml_csv = '/path/to/metapipeline-input.csv'
    search_idxml_csv = '/path/to/main_workflow/manifests/validation.csv'
    filtered_idxml_csv = '/path/to/main_workflow/manifests/quant-idxml.csv'
    inference_route = 'ProteinProphet'
    protein_groups = '/path/to/cohort-grouped.idXML'
    protein_quant_csv = '/path/to/cohort_ProteinQuantifier_protein.csv'
    peptide_quant_csv = '/path/to/cohort_ProteinQuantifier_peptide.csv'
    output_dir = '/path/to/qc-output'
}
methods.setup()
